<Application x:Class="LightsOut.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">

    <Application.Resources>

        <SolidColorBrush x:Key="DocumentBlue"
                         Color="#1E4E79"/>

        <SolidColorBrush x:Key="DocumentBlueLight"
                         Color="#4D86B7"/>

        <SolidColorBrush x:Key="MutedBrush"
                         Color="#666666"/>

        <SolidColorBrush x:Key="TextBrush"
                         Color="#222222"/>

        <SolidColorBrush x:Key="RedState"
                         Color="#D94A4A"/>

        <SolidColorBrush x:Key="GreenState"
                         Color="#43A047"/>

        <SolidColorBrush x:Key="BlueState"
                         Color="#3978C6"/>

        <SolidColorBrush x:Key="YellowState"
                         Color="#D6A52C"/>

        <Style x:Key="BodyText"
               TargetType="TextBlock">

            <Setter Property="FontFamily"
                    Value="Georgia"/>

            <Setter Property="FontSize"
                    Value="15"/>

            <Setter Property="Foreground"
                    Value="{StaticResource TextBrush}"/>

        </Style>

        <Style x:Key="SectionHeading"
               TargetType="TextBlock">

            <Setter Property="FontFamily"
                    Value="Georgia"/>

            <Setter Property="FontSize"
                    Value="22"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="{StaticResource DocumentBlue}"/>

            <Setter Property="Margin"
                    Value="0,0,0,8"/>

        </Style>

        <Style x:Key="InputBox"
               TargetType="TextBox">

            <Setter Property="FontFamily"
                    Value="Consolas"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Padding"
                    Value="8"/>

            <Setter Property="BorderBrush"
                    Value="#D5D5D5"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Background"
                    Value="White"/>

        </Style>

        <Style x:Key="OutlineButton"
               TargetType="Button">

            <Setter Property="Height"
                    Value="34"/>

            <Setter Property="Padding"
                    Value="15,5"/>

            <Setter Property="Margin"
                    Value="5,0"/>

            <Setter Property="FontFamily"
                    Value="Segoe UI"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource DocumentBlue}"/>

            <Setter Property="Foreground"
                    Value="{StaticResource DocumentBlue}"/>

            <Setter Property="Background"
                    Value="White"/>

        </Style>

        <Style x:Key="DocumentButton"
               TargetType="Button"
               BasedOn="{StaticResource OutlineButton}">

            <Setter Property="Background"
                    Value="{StaticResource DocumentBlue}"/>

            <Setter Property="Foreground"
                    Value="White"/>

        </Style>

    </Application.Resources>

</Application>
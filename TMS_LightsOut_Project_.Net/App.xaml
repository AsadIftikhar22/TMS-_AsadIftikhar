<Application x:Class="LightsOut.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="DocumentBlue" Color="#2B5D8F"/>
        <SolidColorBrush x:Key="DocumentBlueLight" Color="#6E9CC6"/>
        <SolidColorBrush x:Key="TextBrush" Color="#171717"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#5E5E5E"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#FAFAFA"/>
        <SolidColorBrush x:Key="RedState" Color="#E53935"/>
        <SolidColorBrush x:Key="GreenState" Color="#2EAD4F"/>
        <SolidColorBrush x:Key="BlueState" Color="#3D82D6"/>
        <SolidColorBrush x:Key="YellowState" Color="#E4B83B"/>

        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource DocumentBlue}"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,18,0,5"/>
        </Style>

        <Style x:Key="BodyText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="LineHeight" Value="23"/>
        </Style>

        <Style x:Key="DocumentButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource DocumentBlue}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="OutlineButton" TargetType="Button" BasedOn="{StaticResource DocumentButton}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource DocumentBlue}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DocumentBlue}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="BorderBrush" Value="#B7B7B7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>
    </Application.Resources>
</Application>

<Window x:Class="LightsOut.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lights Out Solver"
        Width="1400"
        Height="900"
        MinWidth="1000"
        MinHeight="700"
        Background="#F5F7FA">

    <Window.Resources>

        <!-- ================================================= -->
        <!-- COLORS -->
        <!-- ================================================= -->

        <SolidColorBrush x:Key="DocumentBlueLight"
                         Color="#4D86B7"/>

        <SolidColorBrush x:Key="TextBrush"
                         Color="#222222"/>

        <SolidColorBrush x:Key="MutedBrush"
                         Color="#666666"/>

        <SolidColorBrush x:Key="RedState"
                         Color="#C94C4C"/>

        <SolidColorBrush x:Key="GreenState"
                         Color="#4CAF50"/>

        <SolidColorBrush x:Key="BlueState"
                         Color="#4D86B7"/>

        <SolidColorBrush x:Key="YellowState"
                         Color="#D6A72C"/>

        <Style TargetType="Button">

            <Setter Property="Padding"
                    Value="20,9"/>

            <Setter Property="Margin"
                    Value="0,5,0,5"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

        </Style>

    </Window.Resources>

    <!-- ===================================================== -->
    <!-- MAIN -->
    <!-- ===================================================== -->

    <Grid>

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>

        <!-- ================================================= -->
        <!-- HEADER -->
        <!-- ================================================= -->

        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#DDDDDD"
                BorderThickness="0,0,0,1"
                Padding="24">

            <StackPanel>

                <TextBlock Text="Lights Out Solver"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#222222"/>

                <TextBlock Text="Each sample is displayed independently with its own problem, pieces, solution and Solve button."
                           Margin="0,7,0,0"
                           Foreground="#666666"
                           FontSize="14"/>

                <TextBlock x:Name="OverallStatusText"
                           Margin="0,8,0,0"
                           Foreground="#4D86B7"
                           FontWeight="SemiBold"/>

            </StackPanel>

        </Border>

        <!-- ================================================= -->
        <!-- SAMPLES -->
        <!-- ================================================= -->

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">

            <StackPanel x:Name="SamplesPanel"
                        Margin="24"/>

        </ScrollViewer>

    </Grid>

</Window>
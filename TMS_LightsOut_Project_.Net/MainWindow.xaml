<Window x:Class="LightsOut.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Blue Rock Lights Out Solver"
        Width="1200"
        Height="800"
        MinWidth="900"
        MinHeight="600"
        Background="#F5F7FA"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <!-- ================================================= -->
        <!-- COLORS -->
        <!-- ================================================= -->

        <SolidColorBrush x:Key="DocumentBlueLight"
                         Color="#4D86B7"/>

        <SolidColorBrush x:Key="TextBrush"
                         Color="#222222"/>

        <SolidColorBrush x:Key="MutedBrush"
                         Color="#666666"/>

        <SolidColorBrush x:Key="RedState"
                         Color="#C94C4C"/>

        <SolidColorBrush x:Key="GreenState"
                         Color="#4CAF50"/>

        <SolidColorBrush x:Key="BlueState"
                         Color="#4D86B7"/>

        <SolidColorBrush x:Key="YellowState"
                         Color="#D6A72C"/>

        <!-- ================================================= -->
        <!-- BUTTON STYLE -->
        <!-- ================================================= -->

        <Style TargetType="Button">

            <Setter Property="Padding"
                    Value="20,9"/>

            <Setter Property="Margin"
                    Value="0,5,0,5"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

        </Style>

    </Window.Resources>

    <!-- ===================================================== -->
    <!-- MAIN -->
    <!-- ===================================================== -->

    <Grid>

        <Grid.RowDefinitions>

            <!-- Header -->
            <RowDefinition Height="Auto"/>

            <!-- Samples -->
            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>


        <!-- ================================================= -->
        <!-- HEADER -->
        <!-- ================================================= -->

        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#DDDDDD"
                BorderThickness="0,0,0,1"
                Padding="24">

            <Grid>

                <Grid.ColumnDefinitions>

                    <!-- Header text -->
                    <ColumnDefinition Width="*"/>

                    <!-- Reset button -->
                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>


                <!-- ========================================= -->
                <!-- HEADER INFORMATION -->
                <!-- ========================================= -->

                <StackPanel Grid.Column="0">

                    <TextBlock Text="Blue Rock Lights Out Solver"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#222222"/>

                    <TextBlock Text="Loading Lights Out puzzles from the Samples folder, with each .txt file loaded as a separate, independent puzzle sample."
                               Margin="0,7,20,0"
                               Foreground="#666666"
                               FontSize="14"
                               TextWrapping="Wrap"/>

                    <TextBlock x:Name="OverallStatusText"
                               Margin="0,8,0,0"
                               Foreground="#4D86B7"
                               FontWeight="SemiBold"/>

                </StackPanel>


                <!-- ========================================= -->
                <!-- RESET ALL -->
                <!-- ========================================= -->

                <Button x:Name="ResetAllButton"
                        Grid.Column="1"
                        Content="Reset All"
                        Width="120"
                        Height="40"
                        Margin="24,0,0,0"
                        Padding="16,8"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Click="ResetAll_Click"/>

            </Grid>

        </Border>


        <!-- ================================================= -->
        <!-- SAMPLES -->
        <!-- ================================================= -->

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PreviewMouseWheel="SamplesScrollViewer_PreviewMouseWheel">

            <StackPanel x:Name="SamplesPanel"
                        Margin="24"
                        HorizontalAlignment="Stretch"/>

        </ScrollViewer>

    </Grid>

</Window>